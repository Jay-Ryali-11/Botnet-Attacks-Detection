# ================================
# Flask Configuration
# ================================
FLASK_ENV=production

# Generate using:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_long_random_secret_key


# ================================
# Database Configuration
# ================================
# Use "db" when running with Docker, "localhost" for local dev
DB_HOST=db
DB_PORT=3306

# Application database user (DO NOT use root in production)
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_database_name

# Connection pool size
DB_POOL_SIZE=5

# MySQL root password (used only for container initialization)
MYSQL_ROOT_PASSWORD=change_me

# ================================
# Email Configuration
# ================================
# Use an App Password (not your real email password)
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_email_app_password

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False

DEBUG=False